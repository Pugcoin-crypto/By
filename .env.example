# Without any FIREBASE_* variable the app runs on an in-memory store seeded with
# the menu (handy for local development; orders are lost on restart).

# Server (Firebase Admin SDK). Either the whole service-account JSON (raw or base64)…
FIREBASE_SERVICE_ACCOUNT_KEY=
# …or the three separate fields:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Local emulator instead of a real project (firebase emulators:start):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Browser (Firebase web app config) – used by the live order board and tracking page.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
